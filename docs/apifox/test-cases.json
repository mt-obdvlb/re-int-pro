    {
      "case_key": "API-05",
      "operation_id": "createRun",
      "name": "创建合法诊断运行",
      "category": "正向",
      "parameters": {
        "path": {},
        "query": {},
        "header": {
          "Idempotency-Key": "probeops-api05-{{case_nonce}}"
        }
      },
      "body": {
        "incident_id": "demo_001",
        "strategy_id": "competitive_cost",
        "limits": {
          "max_steps": 12,
          "max_llm_calls": 16,
          "max_wall_seconds": 180,
          "max_cost_micro_cny": 250000
        }
      },
      "assertions": [
        {
          "subject": "httpCode",
          "comparison": "equal",
          "path": "",
          "value": "202"
        },
        {
          "subject": "responseJson",
          "comparison": "exists",
          "path": "$.run_id"
        },
        {
          "subject": "responseJson",
          "comparison": "equal",
          "path": "$.status",
          "value": "queued"
        }
      ]
    },
