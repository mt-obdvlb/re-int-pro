{
  "status": "design",
  "description": "用例设计源，operation_id需绑定Apifox生成的真实endpointId；非可直接导入的CLI payload。API-05在运行时生成case_nonce。",
  "cases": [
    {
      "case_key": "API-01",
      "operation_id": "health",
      "name": "存活与版本",
      "category": "正向",
      "parameters": {
        "path": {},
        "query": {},
        "header": {}
      },
      "body": null,
      "assertions": [
        {
          "subject": "httpCode",
          "comparison": "equal",
          "path": "",
          "value": "200"
        },
        {
          "subject": "responseJson",
          "comparison": "equal",
          "path": "$.status",
          "value": "ok"
        },
        {
          "subject": "responseJson",
          "comparison": "exists",
          "path": "$.version"
        }
      ]
    },
    {
