# fake validates the pipeline for free; bailian enables real billed requests.
LLM_MODE=fake
BAILIAN_API=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus-2025-12-01
PROBEOPS_DB_PATH=.runtime/probeops.sqlite3
PROBEOPS_TELEMETRY_DIR=.runtime/telemetry
LOG_LEVEL=INFO
PROBEOPS_SNAPSHOT_DIR=data/snapshots
# 1 CNY integration cap, within the immutable 450 CNY admission / 500 CNY total budget.
PROBEOPS_SPEND_CAP_MICRO_CNY=1000000
# Optional, use with local Jaeger: http://127.0.0.1:4318/v1/traces
OTLP_ENDPOINT=
